        "operationId": "AuthController_login",
        "summary": "Login with email and password",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "Authentication"
        ]
      }
    }
  },
  "info": {
    "title": "QuickPlan API Spec",
    "description": "Voice-first Smart Todo + Reminder + Expense/IOU Engine API Documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "AI Smart Input",
      "description": "One-sentence natural language input processing"
    },
    {
      "name": "Tasks",
      "description": "Task management endpoints"
    },
    {
      "name": "Expenses & IOUs",
      "description": "Expense splitting and IOU management"
    },
    {
      "name": "People & Contacts",
      "description": "Contact balance tracking"
    },
    {
      "name": "Reminders",
      "description": "Reminder scheduling"
    },
    {
      "name": "Notifications",
      "description": "PWA push notifications"
    },
    {
      "name": "User & Settings",
      "description": "User registration and configuration"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "x-user-id": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-id"
      },
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the task",
            "example": "Call Rahul to discuss project"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes or sub-details",
            "example": "Review report beforehand"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "description": "Task current status",
            "example": "PENDING"
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "URGENT"
            ],
            "description": "Task priority level",
            "example": "HIGH"
          },
          "category": {
            "type": "string",
            "description": "Task category / tag",
            "example": "Work"
          },
          "dueDate": {
            "type": "string",
            "description": "Due date in ISO 8601 string format",
            "example": "2026-08-20T10:00:00.000Z"
          },
          "isCompleted": {
            "type": "boolean",
            "description": "Completion status flag",
            "example": false
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateTaskDto": {
        "type": "object",
        "properties": {}
      },
      "CreateReminderDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Reminder title / message",
            "example": "Call Rahul"
          },
          "dueAt": {
            "type": "string",
            "description": "Due date in ISO 8601 string format",
            "example": "2026-08-20T17:00:00.000Z"
          },
          "taskId": {
            "type": "string",
            "description": "Optional associated task ID",
            "example": "tsk-101"
          },
          "offsetMinutes": {
            "type": "number",
            "description": "Trigger notification N minutes before dueAt",
            "example": 30,
            "default": 0
          },
          "recurrenceRule": {
            "type": "string",
            "description": "Recurrence rule: DAILY, WEEKLY, WEEKDAYS, MONTHLY",
            "example": "DAILY"
          }
        },
        "required": [
          "title",
          "dueAt"
        ]
      },
      "UpdateReminderDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Reminder title",
            "example": "Call Rahul"
          },
          "dueAt": {
            "type": "string",
            "description": "Due moment, ISO 8601 (UTC)"
          },
          "offsetMinutes": {
            "type": "number",
            "description": "Alert this many minutes before dueAt",
            "example": 30
          },
          "recurrenceRule": {
            "type": "string",
            "description": "DAILY, WEEKDAYS, WEEKLY or MONTHLY"
          },
          "taskId": {
            "type": "string",
            "description": "Associated task id"
          }
        }
      },
      "CreateIOUDto": {
        "type": "object",
        "properties": {
          "personName": {
            "type": "string",
            "description": "Contact / Person name",
            "example": "Rahul"
          },
          "amount": {
            "type": "number",
            "description": "IOU amount in INR",
            "example": 100
          },
          "direction": {
            "type": "string",
            "enum": [
              "PAYABLE",
              "RECEIVABLE"
            ],
            "description": "Direction: PAYABLE (I owe them) or RECEIVABLE (They owe me)",
            "example": "PAYABLE"
          },
          "reason": {
            "type": "string",
            "description": "Reason for the expense / IOU",
            "example": "Pizza"
          }
        },
        "required": [
          "personName",
          "amount",
          "direction"
        ]
      },
      "SplitExpenseDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title or reason for group expense",
            "example": "Pizza Party"
          },
          "totalAmount": {
            "type": "number",
            "description": "Total expense amount in INR",
            "example": 500
          },
          "participantsCount": {
            "type": "number",
            "description": "Total number of participants sharing the bill (including Me)",
            "example": 5
          },
          "paidByMe": {
            "type": "boolean",
            "description": "Flag indicating if current user paid the full bill upfront",
            "example": true,
            "default": true
          },
          "names": {
            "description": "Optional list of participant names (if known upfront)",
            "example": [
              "Rahul",
              "Amit",
              "Neha"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "totalAmount",
          "participantsCount"
        ]
      },
      "AddNamesDto": {
        "type": "object",
        "properties": {
          "names": {
            "description": "List of participant names to assign to anonymous slots",
            "example": [
              "Neha",
              "Vishal"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "names"
        ]
      },
      "CreatePersonDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name of the contact",
            "example": "Rahul Sharma"
          },
          "nickname": {
            "type": "string",
            "description": "Optional nickname",
            "example": "Rahul"
          },
          "phone": {
            "type": "string",
            "description": "Contact phone number",
            "example": "+919876543210"
          },
          "email": {
            "type": "string",
            "description": "Contact email address",
            "example": "rahul@example.com"
          }
        },
        "required": [
          "name"
        ]
      },
      "SmartInputDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Natural language text or voice transcript in Hindi, English, or Hinglish",
            "example": "Kal 5 baje Rahul ko pizza ke 100 rupee dene hain aur 30 minute pehle yaad dila dena"
          }
        },
        "required": [
          "text"
        ]
      },
      "SubscribePushDto": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "description": "Push endpoint issued by the browser vendor",
            "example": "https://web.push.apple.com/sample_endpoint"
          },
          "p256dh": {
            "type": "string",
            "description": "Web Push P256DH public key",
            "example": "BIPpSAMPLEKEY123"
          },
          "auth": {
            "type": "string",
            "description": "Web Push auth secret",
            "example": "8eTSAMPLEAUTH456"
          },
          "userAgent": {
            "type": "string",
            "description": "Device description, kept for debugging"
          }
        },
        "required": [
          "endpoint",
          "p256dh",
          "auth"
        ]
      },
      "UnsubscribePushDto": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "description": "The endpoint to forget, as returned by the browser",
            "example": "https://web.push.apple.com/sample_endpoint"
          }
        },
        "required": [
          "endpoint"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "User full name (mandatory)",
            "example": "Abhi Sharma"
          },
          "email": {
            "type": "string",
            "description": "User email address (mandatory)",
            "example": "abhi@example.com"
          },
          "password": {
            "type": "string",
            "description": "Account password (mandatory)",
            "example": "strong-password",
            "minLength": 8
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateSettingsDto": {
        "type": "object",
        "properties": {
          "inputLanguage": {
            "type": "string",
            "description": "Preferred input language: AUTO, HINDI, ENGLISH",
            "example": "AUTO"
          },
          "outputLanguage": {
            "type": "string",
            "description": "Preferred output language: SAME, HINDI, ENGLISH",
            "example": "SAME"
          },
          "notificationsEnabled": {
            "type": "boolean",
            "description": "Notification master toggle flag",
            "example": true
          },
          "defaultReminderOffsetMinutes": {
            "type": "number",
            "description": "Default reminder offset minutes",
            "example": 15
          },
          "defaultPriority": {
            "type": "string",
            "description": "Default task priority: LOW, MEDIUM, HIGH, URGENT",
            "example": "MEDIUM"
          },
          "defaultCategory": {
            "type": "string",
            "description": "Default task category",
            "example": "General"
          },
          "currency": {
            "type": "string",
            "description": "Default currency symbol/code",
            "example": "INR"
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "abhi@example.com"
          },
          "password": {
            "type": "string",
            "example": "strong-password",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}