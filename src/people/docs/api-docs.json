{
  "module": "PeopleModule",
  "basePath": "/api/people",
  "description": "Contacts and participant directory with aggregate net balance and transaction history.",
  "endpoints": [
    {
      "name": "Create Person / Contact",
      "method": "POST",
      "path": "/api/people",
      "requestPayload": {
        "requiredFields": ["name"],
        "schema": {
          "name": { "type": "string", "example": "Rahul Sharma" },
          "nickname": { "type": "string", "example": "Rahul" },
          "phone": { "type": "string", "example": "+919876543210" },
          "email": { "type": "string", "example": "rahul@example.com" }
        },
        "example": {
          "name": "Rahul Sharma",
          "nickname": "Rahul",
          "phone": "+919876543210"
        }
      },
      "responsePayload": {
        "status": 201,
        "example": {
          "id": "per-301",
          "name": "Rahul Sharma",
          "nickname": "Rahul",
          "createdAt": "2026-08-19T14:40:00.000Z"
        }
      }
    },
    {
      "name": "List People with Net Balances",
      "method": "GET",
      "path": "/api/people",
      "description": "Returns all contacts with computed youOwePerson, personOwesYou, and netBalance.",
      "responsePayload": {
        "status": 200,
        "example": [
          {
            "id": "per-301",
            "name": "Rahul Sharma",
            "youOwePerson": 100,
            "personOwesYou": 350,
            "netBalance": 250
          }
        ]
      }
    },
    {
      "name": "Get Contact Transaction History",
      "method": "GET",
      "path": "/api/people/:id/history",
      "pathParams": {
        "id": { "type": "string", "example": "per-301" }
      },
      "responsePayload": {
        "status": 200,
        "example": {
          "person": { "id": "per-301", "name": "Rahul Sharma" },
          "transactions": [
            { "id": "exp-201", "title": "Pizza", "shareAmount": 100, "type": "IOU_PAYABLE", "status": "PENDING" },
            { "id": "exp-202", "title": "Movie", "shareAmount": 150, "type": "SPLIT_EXPENSE", "status": "PENDING" }
          ]
        }
      }
    }
  ]
}
