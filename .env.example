# ====================================================================
# NEON POSTGRESQL DATABASE CONFIGURATION (.env.example)
# ====================================================================

DATABASE_URL="postgresql://neondb_owner:npg_hl6fuk1VZoGm@ep-round-base-aycxb85y-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:npg_hl6fuk1VZoGm@ep-round-base-aycxb85y.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"

PORT=3000
JWT_SECRET="quick-plan-SX5y8O8xiOylsNBUAOCBMDf14W35ggEk0oCpEAM+MRw="

# Comma-separated list of allowed frontend origins (leave empty to reflect any origin)
CORS_ORIGINS="http://localhost:5173,https://abhi0303.github.io/"

# Enables GET /health/net, which reports how the database host resolves and
# whether each address is reachable. Send it as the x-diagnostics-token header.
# Leave unset to remove the route entirely.
DIAGNOSTICS_TOKEN=""

# Web Push (VAPID). Generate once with: npx web-push generate-vapid-keys
# The public key is also given to the frontend as VITE_VAPID_PUBLIC_KEY.
# Regenerating invalidates every existing subscription.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Brevo transactional email. Note this is the /v3/smtp/email API, not the
# campaigns endpoint — campaigns are for marketing sends and would be the wrong
# tool for a reset link. MAIL_FROM must be a sender Brevo has verified.
BREVO_API_KEY=""

# Or, instead of Brevo: any SMTP provider, for password reset links. SMTP rather than a provider SDK, so Resend,
# SendGrid, Mailgun, SES or a Gmail app password all work with the same four
# variables. Leave unset and reset emails are written to the log instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="QuickPlan <no-reply@yourdomain.com>"

# Where the reset link points; the frontend origin.
APP_URL="https://abhi0303.github.io/QuickPlan-FE"
