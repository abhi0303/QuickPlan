generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ExpenseType {
  IOU_PAYABLE
  IOU_RECEIVABLE
  SPLIT_EXPENSE
}

enum ExpenseStatus {
  PENDING
  SETTLED
}

enum ParticipantStatus {
  PENDING
  PAID
}

model User {
  id            String             @id @default(uuid())
  email         String?            @unique
  name          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  passwordHash  String?
  expenses      Expense[]
  people        Person[]
  subscriptions PushSubscription[]
  reminders     Reminder[]
  tasks         Task[]
  settings      UserSettings?
}

model UserSettings {
  id                           String  @id @default(uuid())
  userId                       String  @unique
  inputLanguage                String  @default("AUTO")
  outputLanguage               String  @default("SAME")
  notificationsEnabled         Boolean @default(true)
  defaultReminderOffsetMinutes Int     @default(15)
  defaultPriority              String  @default("MEDIUM")
  defaultCategory              String  @default("General")
  currency                     String  @default("INR")
  defaultSplitType             String  @default("EQUAL")
  user                         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          String     @id @default(uuid())
  userId      String
  title       String
  notes       String?
  status      String     @default("PENDING")
  priority    String     @default("MEDIUM")
  category    String     @default("General")
  dueDate     DateTime?
  isCompleted Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  reminders   Reminder[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id             String   @id @default(uuid())
  userId         String
  taskId         String?
  title          String
  dueAt          DateTime
  offsetMinutes  Int      @default(0)
  recurrenceRule String?
  status         String   @default("PENDING")
  pushSent       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Person {
  id           String               @id @default(uuid())
  userId       String
  name         String
  /// Lower-cased name, so "Rahul" and "rahul" cannot become two contacts.
  nameKey      String
  nickname     String?
  phone        String?
  email        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  participants ExpenseParticipant[]
  paidExpenses Expense[]            @relation("ExpensePaidBy")
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nameKey])
  @@index([userId])
}

model Expense {
  id                       String               @id @default(uuid())
  userId                   String
  title                    String
  totalAmount              Decimal              @db.Decimal(12, 2)
  currency                 String               @default("INR")
  /// True when the user fronted the money. When false, paidById names the
  /// contact who did, which is what makes "I owe" answerable.
  paidByMe                 Boolean              @default(true)
  paidById                 String?
  type                     ExpenseType
  status                   ExpenseStatus        @default(PENDING)
  participantsCount        Int                  @default(1)
  unnamedParticipantsCount Int                  @default(0)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidBy                   Person?              @relation("ExpensePaidBy", fields: [paidById], references: [id])
  participants             ExpenseParticipant[]

  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, createdAt])
  @@index([paidById])
}

model ExpenseParticipant {
  id          String            @id @default(uuid())
  expenseId   String
  personId    String?
  isMe        Boolean           @default(false)
  shareAmount Decimal           @db.Decimal(12, 2)
  status      ParticipantStatus @default(PENDING)
  paidAt      DateTime?
  expense     Expense           @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person      Person?           @relation(fields: [personId], references: [id])

  @@index([expenseId])
  @@index([personId, status])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
