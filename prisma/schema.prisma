generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GroupRole {
  OWNER
  MEMBER
}

/// How an entity got created. The mission engine uses this to tell a
/// voice-created task from a typed one.
enum CreatedVia {
  MANUAL
  VOICE
  IMPORT
  SYSTEM
}

enum MissionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

/// Adding a type here plus one entry in the mission catalogue is all a new
/// mission needs - no schema change and no engine rewrite.
enum MissionType {
  EXPENSE_COUNT
  EXPENSE_CATEGORY_COUNT
  EXPENSE_DAY_COUNT
  TASK_CREATE_COUNT
  TASK_CREATE_VOICE_COUNT
  TASK_COMPLETE_COUNT
  REMINDER_CREATE_COUNT
  REMINDER_CREATE_VOICE_COUNT
}

enum BudgetPeriod {
  MONTHLY
  WEEKLY
}

/// PERSONAL is your own spending; ALL adds your share of group expenses.
/// "8,000 on food" usually means your food, not a group dinner in Goa.
enum BudgetScope {
  PERSONAL
  ALL
}

enum BudgetStatus {
  ON_TRACK
  WARNING
  EXCEEDED
}

enum PlanItemSource {
  RECURRING
  CATEGORY
}

enum RecurringCadence {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationType {
  FRIEND_ADDED
  GROUP_MEMBER_ADDED
  GROUP_MEMBER_REMOVED
  GROUP_ROLE_CHANGED
  GROUP_DELETED
  EXPENSE_ADDED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_RECORDED
  REMINDER_LEAD
  REMINDER_DUE
  TASK_DUE
  MISSION_COMPLETED
  LEVEL_UP
  BUDGET_WARNING
  BUDGET_EXCEEDED
}

/// A coffee is not a trip. PERSONAL expenses belong to one person's ledger and
/// have no group, no payer and no shares; GROUP expenses have all three.
enum ExpenseScope {
  PERSONAL
  GROUP
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

model User {
  id                    String             @id @default(uuid())
  email                 String?            @unique
  name                  String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  passwordHash          String?
  /// Only the running total and the derived level are stored. Level bands and
  /// rank names are static config, never duplicated per user.
  totalXp               Int                @default(0)
  currentLevel          Int                @default(1)
  /// Which version of the tour this user finished. Kept as a number rather than
  /// a boolean so a materially changed tour can be shown again without a
  /// migration or a per-user reset.
  onboardingVersion     Int                @default(0)
  /// Last step reached, so a tour abandoned halfway resumes where it stopped.
  onboardingStep        Int                @default(0)
  onboardingCompletedAt DateTime?
  subscriptions         PushSubscription[]
  reminders             Reminder[]
  tasks                 Task[]
  settings              UserSettings?

  friendsAdded        Friendship[]       @relation("FriendshipOwner")
  friendsOf           Friendship[]       @relation("FriendshipTarget")
  memberships         GroupMember[]
  groupsCreated       Group[]            @relation("GroupCreator")
  expensesPaid        Expense[]          @relation("ExpensePaidBy")
  expensesOwned       Expense[]          @relation("ExpenseOwner")
  expensesCreated     Expense[]          @relation("ExpenseCreatedBy")
  shares              ExpenseShare[]
  settlementsPaid     Settlement[]       @relation("SettlementFrom")
  settlementsGot      Settlement[]       @relation("SettlementTo")
  settlementsCreated  Settlement[]       @relation("SettlementCreatedBy")
  notifications       Notification[]     @relation("NotificationRecipient")
  notificationsCaused Notification[]     @relation("NotificationActor")
  missions            UserMission[]
  budgets             Budget[]
  recurringExpenses   RecurringExpense[]
  plans               BudgetPlan[]
}

model UserSettings {
  id                           String  @id @default(uuid())
  userId                       String  @unique
  inputLanguage                String  @default("AUTO")
  outputLanguage               String  @default("SAME")
  notificationsEnabled         Boolean @default(true)
  defaultReminderOffsetMinutes Int     @default(15)
  defaultPriority              String  @default("MEDIUM")
  defaultCategory              String  @default("General")
  currency                     String  @default("INR")
  defaultSplitType             String  @default("EQUAL")
  user                         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          String     @id @default(uuid())
  userId      String
  title       String
  notes       String?
  status      String     @default("PENDING")
  priority    String     @default("MEDIUM")
  category    String     @default("General")
  dueDate     DateTime?
  isCompleted Boolean    @default(false)
  /// Set when the task is first marked done, so "complete 3 tasks this cycle"
  /// can be counted without a separate history table.
  completedAt DateTime?
  createdVia  CreatedVia @default(MANUAL)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  reminders   Reminder[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Reminder {
  id             String     @id @default(uuid())
  userId         String
  taskId         String?
  title          String
  /// The moment the reminder is for. The lead-in alert is derived from this
  /// and offsetMinutes; it is never stored in place of it.
  dueAt          DateTime
  offsetMinutes  Int        @default(0)
  recurrenceRule String?
  status         String     @default("PENDING")
  pushSent       Boolean    @default(false)
  /// Set when each of the two alerts has gone out, so a restart cannot resend
  /// and a passed reminder cannot fire on every tick.
  sentLeadAt     DateTime?
  sentDueAt      DateTime?
  createdVia     CreatedVia @default(MANUAL)
  /// iCalendar SEQUENCE. Bumped on every edit, because calendar clients ignore
  /// a re-imported event whose sequence has not moved.
  sequence       Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  task           Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, dueAt])
}

/// Directed edge. Adding a friend writes both directions, so either side can
/// list the other without a UNION and neither can be a friend one-way only.
model Friendship {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())
  user      User     @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendshipTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  currency    String   @default("INR")
  /// The original creator. Kept separate from role so the founder is still
  /// identifiable after other members are promoted to owner.
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User               @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  recurring   RecurringExpense[]

  @@index([createdById])
}

/// Membership is the only thing that grants access to a group's expenses,
/// balances and settlements. Every read and write checks for a row here.
model GroupMember {
  id       String    @id @default(uuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model Expense {
  id          String       @id @default(uuid())
  scope       ExpenseScope @default(GROUP)
  /// Whose money this affects: the ledger owner for a personal expense, the
  /// payer for a group one, so one index answers "everything touching this
  /// person's money".
  ownerId     String
  groupId     String?
  title       String
  /// Exposed to clients as `notes`. One column rather than a near-identical
  /// second field.
  description String?
  totalAmount Decimal      @db.Decimal(12, 2)
  currency    String       @default("INR")
  /// GROUP only. Null on a personal expense - there is nobody else to have paid.
  paidById    String?
  createdById String
  /// GROUP only. A personal expense is not split.
  splitType   SplitType?
  /// Expenses have no voice flow today; this exists so the mission engine reads
  /// the same field everywhere.
  createdVia  CreatedVia   @default(MANUAL)
  /// Category drives the breakdown charts, and date drives the time series -
  /// both are indexed because the analytics endpoints group on them.
  category    String       @default("General")
  date        DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  group     Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: ownerId is the payer on a group expense, so
  /// cascading would delete expenses other members' balances depend on.
  owner     User           @relation("ExpenseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  /// Restrict rather than the default SetNull for an optional relation, which
  /// would null a payer the GROUP branch of the check constraint requires.
  paidBy    User?          @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  createdBy User           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  shares    ExpenseShare[]

  @@index([groupId, date])
  @@index([groupId, category])
  @@index([paidById])
  @@index([ownerId, scope, date])
}

/// What each member owes for one expense. Shares always sum to totalAmount.
model ExpenseShare {
  id        String  @id @default(uuid())
  expenseId String
  userId    String
  amount    Decimal @db.Decimal(12, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}

/// A real payment from one member to another. Balances are expenses minus
/// settlements, so this doubles as the payment history the charts read.
model Settlement {
  id          String   @id @default(uuid())
  groupId     String
  fromUserId  String
  toUserId    String
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  settledAt   DateTime @default(now())
  createdById String
  createdAt   DateTime @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from      User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  to        User  @relation("SettlementTo", fields: [toUserId], references: [id])
  createdBy User  @relation("SettlementCreatedBy", fields: [createdById], references: [id])

  @@index([groupId, settledAt])
  @@index([fromUserId])
  @@index([toUserId])
}

model PushSubscription {
  id           String    @id @default(uuid())
  userId       String
  /// Unique per browser install; the frontend re-subscribes on every load, so
  /// this is the upsert key that stops duplicate rows and duplicate alerts.
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?
  lastUsedAt   DateTime?
  failureCount Int       @default(0)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One row per recipient per event. Written by the same emit path that sends
/// the push, so a missed banner can always be found in the bell menu.
model Notification {
  id        String           @id @default(uuid())
  /// The recipient, never the actor.
  userId    String
  type      NotificationType
  /// Wording is composed server-side so the push banner and the feed row read
  /// identically.
  title     String
  body      String
  /// App path, not an absolute URL - the service worker resolves it against
  /// the app scope.
  url       String
  actorId   String?
  /// groupId and entityId are deliberately plain columns rather than foreign
  /// keys: a GROUP_DELETED or EXPENSE_DELETED notification has to outlive the
  /// row it refers to.
  groupId   String?
  entityId  String?
  data      Json?
  readAt    DateTime?
  /// When a push actually went out, for debugging silent devices.
  pushedAt  DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Only the current cycle is kept - at most three rows per user. Expired sets
/// are deleted rather than archived, so this table never grows with history.
model UserMission {
  id        String        @id @default(uuid())
  userId    String
  type      MissionType
  target    Int
  progress  Int           @default(0)
  status    MissionStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One mission of a given type per user, so a cycle cannot contain duplicates.
  @@unique([userId, type])
  @@index([userId, status])
  @@index([expiresAt])
}

/// Replay cache for retried mutations. A request that succeeded but whose
/// response was lost on the way back is the common failure on a flaky mobile
/// network; without this the client's retry creates a second row.
model IdempotencyKey {
  /// Client-generated, created once when the mutation is queued and reused on
  /// every retry.
  key         String
  /// Scoped per user: the same key from a different account is a different
  /// request, and one user must never be able to read another's stored response.
  userId      String
  /// sha256 of the raw body, so a key reused with different content is caught
  /// rather than silently answered with the wrong response.
  requestHash String
  /// Null while the original request is still running.
  status      Int?
  response    Json?
  createdAt   DateTime @default(now())

  @@id([userId, key])
  @@index([createdAt])
}

model Budget {
  id         String       @id @default(uuid())
  userId     String
  /// Null is the overall budget for everything - one concept, one table, not a
  /// special row type.
  category   String?
  amount     Decimal      @db.Decimal(12, 2)
  period     BudgetPeriod @default(MONTHLY)
  scope      BudgetScope  @default(PERSONAL)
  startsOn   DateTime     @db.Date
  /// Archived rather than deleted: a budget removed in March must not rewrite
  /// what February looked like.
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts BudgetPeriodAlert[]

  @@index([userId, archivedAt])
}

/// One row per budget per period, holding the highest status already announced.
/// Alerting on every expense past 80% is how people turn notifications off.
model BudgetPeriodAlert {
  id         String       @id @default(uuid())
  budgetId   String
  /// "2026-08" for monthly, "2026-W34" for weekly.
  periodKey  String
  lastStatus BudgetStatus
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, periodKey])
}

model RecurringExpense {
  id         String           @id @default(uuid())
  userId     String
  scope      ExpenseScope     @default(PERSONAL)
  groupId    String?
  title      String
  amount     Decimal          @db.Decimal(12, 2)
  category   String?
  cadence    RecurringCadence
  /// MONTHLY: 1-31, clamped to the last day in shorter months so rent set for
  /// the 31st lands on the 28th in February rather than skipping it.
  dayOfMonth Int?
  /// WEEKLY: 0 (Sunday) to 6.
  weekday    Int?
  nextRunAt  DateTime
  /// The period already generated. Written in the same transaction as the
  /// expense, so a scheduler that crashes mid-run or runs twice cannot create
  /// rent twice - the same discipline as sentLeadAt/sentDueAt on reminders.
  lastRunKey String?
  endsOn     DateTime?        @db.Date
  pausedAt   DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
  @@index([userId])
}

/// Income in, commitments and an estimate out, and the number left over.
/// Archived rather than edited when income changes, so last month's plan keeps
/// the income that was in force - and so "you are saving more than in June"
/// stays answerable.
model BudgetPlan {
  id            String    @id @default(uuid())
  userId        String
  /// The most sensitive field the app holds. It must never reach logs,
  /// analytics or a notification payload.
  monthlyIncome Decimal   @db.Decimal(12, 2)
  savingsTarget Decimal?  @db.Decimal(12, 2)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items BudgetPlanItem[]

  @@index([userId, archivedAt])
}

/// Items reference, they do not snapshot: a RECURRING item stores the id and
/// reads the schedule's current amount, so when rent goes up the plan follows.
/// Only `included` and `amountOverride` are the user's own data.
model BudgetPlanItem {
  id             String         @id @default(uuid())
  planId         String
  source         PlanItemSource
  recurringId    String?
  category       String?
  included       Boolean        @default(true)
  /// Null means "keep tracking the live value".
  amountOverride Decimal?       @db.Decimal(12, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  plan BudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, recurringId])
  @@unique([planId, category])
  @@index([planId])
}
